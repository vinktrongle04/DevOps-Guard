# DevOps-Guard Environment Configuration
# Copy this file to .env and fill in the required values

# ─── KNOWLEDGE BASE ──────────
# Optional: Set a custom path for the knowledge base directory
# DEVOPS_GUARD_KB_PATH=./.knowledge-base

# ─── AI SEMANTIC ENGINE ──────
# Only needed if guard.config.js sets aiVerifier.provider to 'openai' or
# 'anthropic' — the default provider is a local Ollama instance and needs
# no key. Not auto-loaded from this file: use `node --env-file=.env` (Node
# >= 20), a shell `export`, or your CI's native secret injection.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── DASHBOARD ───────────────
# Optional: Configure the UI dashboard
PORT=5173
VITE_API_URL=http://localhost:5173/api