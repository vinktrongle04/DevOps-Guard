{
  "name": "devops-guard-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DevOps-Guard Monorepo — Security Scanner + Dashboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinktrongle04/DevOps-Guard.git"
  },
  "homepage": "https://github.com/vinktrongle04/DevOps-Guard#readme",
  "bugs": {
    "url": "https://github.com/vinktrongle04/DevOps-Guard/issues"
  },
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "dashboard"
  ],
  "scripts": {
    "dev":              "npm run dev --workspace=devops-guard-dashboard",
    "build":            "npm run build --workspace=devops-guard-dashboard",
    "preview":          "npm run preview --workspace=devops-guard-dashboard",
    "lint":             "eslint .",
    "test":             "vitest run --passWithNoTests",
    "scan":             "devops-guard scan",
    "scan:json":        "devops-guard scan --json",
    "scan:sarif":       "devops-guard scan --sarif",
    "dep":              "npm run dep:core && npm run dep:dashboard",
    "dep:core":         "npm run dep --workspace=devops-guard",
    "dep:dashboard":    "cd dashboard && devops-guard dep",
    "fix":              "devops-guard fix",
    "fix:apply":        "devops-guard fix --apply",
    "all":              "devops-guard all",
    "kb":               "devops-guard kb",
    "prepare":          "husky"
  },
  "dependencies": {
    "devops-guard": "*"
  },
  "devDependencies": {
    "@eslint/js":                "^9.13.0",
    "eslint":                    "^9.13.0",
    "globals":                   "^15.11.0",
    "husky":                     "^9.1.7",
    "vitest":                    "^4.1.10"
  }
}
